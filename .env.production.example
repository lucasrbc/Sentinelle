# ─────────────────────────────────────────────────────────────────────────────
# Sentinelle — variables de PRODUCTION (à copier en `.env` sur le serveur).
# Utilisé par docker-compose.prod.yml. Hébergement en Union européenne (RGPD).
# ─────────────────────────────────────────────────────────────────────────────

# Domaine racine (les sous-domaines app. et api. doivent pointer vers le serveur).
DOMAIN="exemple.fr"
WEB_ORIGIN="https://app.exemple.fr"
API_PUBLIC_URL="https://api.exemple.fr"

# Base de données (service postgis du compose).
POSTGRES_USER="sentinelle"
POSTGRES_PASSWORD="CHANGER_CE_MOT_DE_PASSE"
POSTGRES_DB="sentinelle"
DATABASE_URL="postgresql://sentinelle:CHANGER_CE_MOT_DE_PASSE@postgis:5432/sentinelle?schema=public"

# Auth (Supabase, région UE).
AUTH_PROVIDER="supabase"
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""
ADMIN_EMAILS="vous@exemple.fr"

# Paiements (Stripe).
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stockage : "local" (volume Docker) ou "s3" (recommandé en prod, object storage UE).
STORAGE_PROVIDER="local"

# Reçus fiscaux.
RECEIPT_ORG_NAME="Sentinelle"
RECEIPT_LEGAL_MENTION="Reçu émis sous réserve de validation juridique finale."
