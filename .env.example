# ─────────────────────────────────────────────────────────────────────────────
# Sentinelle — variables d'environnement (exemple).
# Copier en `.env` à la racine : `cp .env.example .env`
# Hébergement Union Européenne obligatoire (RGPD).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL + PostGIS) ──────────────────────────────────
# Correspond au service `postgis` de docker-compose.yml.
DATABASE_URL="postgresql://sentinelle:sentinelle@localhost:5432/sentinelle?schema=public"
# URL directe (sans pooler) utilisée par Prisma Migrate.
DIRECT_DATABASE_URL="postgresql://sentinelle:sentinelle@localhost:5432/sentinelle?schema=public"

# ── Cache Redis ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT="4000"
# Origines autorisées (CORS), séparées par des virgules.
WEB_ORIGIN="http://localhost:3000"

# ── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Auth (PR n°2 — Supabase Auth, hébergé en région UE pour le RGPD) ────────
# Choix du fournisseur côté API : "supabase" (prod) ou "dev" (tests locaux/CI).
AUTH_PROVIDER="supabase"
# URL du projet Supabase (sert à vérifier les jetons à clés asymétriques via JWKS).
SUPABASE_URL=""
# Secret JWT « legacy » (HS256) si le projet l'utilise (Settings → API → JWT).
# Renseigner SUPABASE_URL OU SUPABASE_JWT_SECRET (au moins l'un des deux).
SUPABASE_JWT_SECRET=""
# Secret du fournisseur d'auth "dev" (jetons de test locaux ; jamais en prod).
DEV_AUTH_SECRET="dev-secret-change-me"
# Emails promus automatiquement ADMIN à la première connexion (séparés par ,).
ADMIN_EMAILS=""

# Côté web (client Supabase) — projet hébergé en UE.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Paiements (PR n°5 — Stripe en mode test) ────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Médias / stockage (devis, etc.) ─────────────────────────────────────────
# "local" (disque, dev) ou "s3" (object storage UE : OVH / Scaleway).
STORAGE_PROVIDER="local"
# Mode local : dossier de stockage + URL publique de base de l'API.
UPLOADS_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:4000"
# Mode s3 (object storage UE, S3-compatible) :
S3_ENDPOINT=""
S3_REGION="eu-west-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publique de base des objets (sinon déduite de l'endpoint + bucket).
S3_PUBLIC_URL=""

# ── Seed OpenStreetMap ──────────────────────────────────────────────────────
# Département à importer via l'API Overpass (Bretagne : 22, 29, 35, 56).
DEPT="29"
OVERPASS_URL="https://overpass-api.de/api/interpreter"
