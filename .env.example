# ─────────────────────────────────────────────────────────────────────────────
# Sentinelle — variables d'environnement (exemple).
# Copier en `.env` à la racine : `cp .env.example .env`
# Hébergement Union Européenne obligatoire (RGPD).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL + PostGIS) ──────────────────────────────────
# Correspond au service `postgis` de docker-compose.yml.
DATABASE_URL="postgresql://sentinelle:sentinelle@localhost:5432/sentinelle?schema=public"
# URL directe (sans pooler) utilisée par Prisma Migrate.
DIRECT_DATABASE_URL="postgresql://sentinelle:sentinelle@localhost:5432/sentinelle?schema=public"

# ── Cache Redis ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT="4000"
# Origines autorisées (CORS), séparées par des virgules.
WEB_ORIGIN="http://localhost:3000"

# ── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Auth (PR n°2 — fournisseur managé : Clerk OU Supabase Auth) ─────────────
# Défaut retenu : Clerk (parcours simplifié seniors). Laisser vide en PR n°1.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Alternative Supabase Auth :
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Paiements (PR n°5 — Stripe en mode test) ────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Médias (object storage UE, S3-compatible : OVH / Scaleway) ──────────────
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Seed OpenStreetMap ──────────────────────────────────────────────────────
# Département à importer via l'API Overpass (Bretagne : 22, 29, 35, 56).
DEPT="29"
OVERPASS_URL="https://overpass-api.de/api/interpreter"
