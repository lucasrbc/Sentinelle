# Variables d'environnement du site Next.js (à copier en `.env.local`).
# Next.js lit ce fichier depuis le dossier de l'app (apps/web), pas la racine.
#   cp apps/web/.env.local.example apps/web/.env.local

# Projet Supabase (Settings → API). Ces deux valeurs sont publiques (navigateur).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL de l'API Sentinelle.
NEXT_PUBLIC_API_URL="http://localhost:4000"
